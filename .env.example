# Скопируйте в .env:  cp .env.example .env
# Значения ниже подходят для локального запуска. Для production замените секреты.

APP_ENV=development
# Ключ доступа к API и веб-панели (заголовок X-API-Key / форма входа). В production — минимум 32 символа.
API_SECRET_KEY=dev-only-change-me-0123456789abcdefghijkl
COOKIE_SECURE=0
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# База: по умолчанию SQLite-файл edu_billing.db. Для PostgreSQL (docker compose) задаётся автоматически.
# DATABASE_URL=sqlite:///./edu_billing.db

# Telegram-бот (необязательно). ID администраторов — через запятую (узнать свой: /myid у бота).
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_IDS=
AUTO_START_BOT=0

# Только для docker compose (PostgreSQL)
POSTGRES_USER=edubilling
POSTGRES_PASSWORD=change_me_postgres_password
POSTGRES_DB=edubilling
