APP_ENV=production
API_SECRET_KEY=replace_with_a_long_random_secret
SECRET_MANAGER_PROVIDER=env
# Optional cloud secret backends:
# AWS_SECRET_NAME=my-app-secrets
# GCP_SECRET_NAME=edubilling-secret
# AZURE_KEY_VAULT_URL=https://<vault>.vault.azure.net
# AZURE_SECRET_NAME=api-secret
COOKIE_SECURE=1
POSTGRES_USER=edubilling
POSTGRES_PASSWORD=replace_with_a_strong_alphanumeric_password
POSTGRES_DB=edubilling
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_IDS=
TELEGRAM_ALLOWED_USER_IDS=
AUTO_START_BOT=0
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
